# ===================================
# Prompt2Figma - Professional .gitignore
# ===================================

# ===================================
# Dependencies
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# ===================================
# Build Output
# ===================================
dist/
build/
*.js.map
*.css.map
prompt2Figma-Frontend (Plugin)/dist/

# ===================================
# Environment Variables
# ===================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# ===================================
# IDE & Editor
# ===================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ===================================
# Operating System
# ===================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ===================================
# Logs
# ===================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ===================================
# Testing
# ===================================
coverage/
*.lcov
.nyc_output
.grunt
.lock-wscript
lib-cov

# ===================================
# Temporary Files
# ===================================
*.tmp
*.temp
*.cache
.cache/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist

# ===================================
# Redis & Celery
# ===================================
celerybeat-schedule
celerybeat.pid
*.rdb
dump.rdb

# ===================================
# Database
# ===================================
*.db
*.sqlite
*.sqlite3

# ===================================
# Secrets & Credentials
# ===================================
*.pem
*.key
*.cert
*.crt
secrets/
credentials/

# ===================================
# Documentation Build
# ===================================
docs/_build/
site/

# ===================================
# Misc
# ===================================
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ===================================
# Project Specific
# ===================================
# Figma plugin build artifacts
prompt2Figma-Frontend (Plugin)/dist/code.js
prompt2Figma-Frontend (Plugin)/dist/ui.html
prompt2Figma-Frontend (Plugin)/dist/ui.js

# Backend artifacts
prompt2Figma-Backend/.pytest_cache/
prompt2Figma-Backend/htmlcov/

# Local development files
*.local
.local/
