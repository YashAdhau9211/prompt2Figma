# ===================================
# Prompt2Figma - Git Attributes
# ===================================

# Auto detect text files and perform LF normalization
* text=auto

# ===================================
# Source Code
# ===================================
*.ts text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# ===================================
# Web Files
# ===================================
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# ===================================
# Documentation
# ===================================
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
LICENSE text eol=lf
AUTHORS text eol=lf
CHANGELOG text eol=lf

# ===================================
# Configuration Files
# ===================================
*.conf text eol=lf
*.config text eol=lf
*.ini text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ===================================
# Shell Scripts
# ===================================
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# ===================================
# Windows Scripts
# ===================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===================================
# Binary Files
# ===================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ===================================
# Archives
# ===================================
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# ===================================
# Linguist Overrides
# ===================================
# Mark generated files
dist/* linguist-generated=true
build/* linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true

# Documentation
*.md linguist-documentation

# Vendor files
node_modules/* linguist-vendored
vendor/* linguist-vendored
