{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd prompt2Figma-Backend && pip install -r requirements.txt && npm install"
  },
  "deploy": {
    "startCommand": "cd prompt2Figma-Backend && uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
